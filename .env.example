# The browser's exact public origin. Do not use a wildcard.
GAME_ALLOWED_ORIGINS=https://santorini.example.com
GAME_RECONNECT_SECONDS=60
GAME_MAX_ROOMS=100
WEB_BIND=127.0.0.1
WEB_PORT=8081
# Enable Secure account cookies for your public HTTPS subdomain.
AUTH_SECURE_COOKIE=true
# Optional: use your existing MySQL server (see the private run notes).
# DATABASE_URL=jdbc:mysql://mysql:3306/santorini?serverTimezone=UTC
# DATABASE_USERNAME=santorini
# DATABASE_PASSWORD=replace-on-the-server
# DATABASE_NETWORK=your-existing-data-network
